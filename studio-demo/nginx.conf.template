# Rendered by entrypoint.sh: {{BOUNCE}} is the bare-/ login bounce (kept only
# when a web token was captured). Panel at /, docs at /demo/.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
map $arg_token $dsh_has_token {
    ""      0;
    default 1;
}
map $http_cookie $dsh_has_cookie {
    default 0;
    "~dsh-auth-" 1;
}

server {
    listen 7860;
    server_name _;
    access_log /dev/stdout;
    error_log /dev/stderr warn;

    # Bare / without a session bounces into the panel carrying the web token;
    # requests with a token or a dsh-auth cookie go straight through (the app
    # itself 303s from ?token= to ./, so an unconditional bounce would loop).
    location = / {
        set $dsh_bounce "${dsh_has_token}${dsh_has_cookie}";
        {{BOUNCE}}
        proxy_pass http://127.0.0.1:3082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host 127.0.0.1:3082;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # DSH panel: SPA, API and websockets. Host is rewritten to the loopback
    # authority so the web login fence treats every request as trusted (the
    # platform's ingress rewrites Host to its internal FC name otherwise).
    location / {
        proxy_pass http://127.0.0.1:3082;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host 127.0.0.1:3082;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Docs site (static; its relative links work at any mount point).
    location = /demo { return 301 /demo/; }
    location /demo/ {
        alias /opt/dsh-superagent/studio-demo/site/;
        index index.html;
    }
}
